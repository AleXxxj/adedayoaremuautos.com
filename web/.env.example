# ── Database ────────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
#
# Use the SESSION POOLER url for migrations (port 5432) and the TRANSACTION
# POOLER url for the app at runtime (port 6543). Serverless functions open many
# short-lived connections; the transaction pooler is what stops Postgres running
# out of connection slots.
#
# This is a connection string, not an account password. Never commit the real
# value — .env.local is gitignored.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Supabase (auth + storage) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Bypasses row-level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Lead notifications (phase 4) ────────────────────────────────────────────
RESEND_API_KEY=""
LEAD_ALERT_EMAIL=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
LEAD_ALERT_SMS_TO=""

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Lead alerting (optional — leads are saved regardless) ───────────────────
# Without these, enquiries still reach the admin inbox and the server log.
# With them, you also get an instant email and SMS.
#
# Resend: create an account, verify your sending domain, then set:
#   RESEND_API_KEY, LEAD_ALERT_EMAIL (comma-separated for several recipients)
#   LEAD_ALERT_FROM must be on your verified domain.
#
# Twilio: buy a number, then set TWILIO_* and LEAD_ALERT_SMS_TO.
LEAD_ALERT_FROM="leads@adedayoaremuautos.com"

# ── Website assistant ─────────────────────────────────────────────────────
# Without this the assistant button does not render and /api/assistant returns
# 503 — the site works exactly as it did before, with no dead UI.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5 for the conversation and
# claude-haiku-4-5 for summarising, which is extraction from a
# transcript rather than conversation and does not need the larger model.
ASSISTANT_MODEL=
ASSISTANT_SUMMARY_MODEL=

# Postal address printed in the footer of every broadcast. CAN-SPAM requires a
# valid physical address in commercial email; without this the built-in default
# is used.
MAILING_ADDRESS="Adedayo Aremu Autos, 507 Gillespie St, Greensboro, NC 27401, USA"

# The name recipients see in their inbox, before the address. Without it mail
# clients fall back to the local part of LEAD_ALERT_FROM — so "leads@..."
# shows up as "leads", with a grey avatar reading L.
MAIL_FROM_NAME="Adedayo Aremu Autos"
